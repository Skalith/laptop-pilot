# ================================================================
# LaptopPilot — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ================================================================

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (allow-listed sender)
AUTHORIZED_USER_ID=

# --- Relay / Bridge ---
# Relay URL. ws:// for local dev, wss:// for production.
RELAY_URL=ws://localhost:8765
# Shared secret: every client (orchestrator + agent2) must present it
RELAY_SECRET=

# --- LLM providers — factory + automatic failover ---
# Comma-separated fallback order. Only include providers whose keys you set:
# the factory fails fast if a configured provider has no key.
LLM_PROVIDER_ORDER=gemini
# Set to false to disable failover (single provider mode)
LLM_FALLBACK_ENABLED=true
# API keys (one per provider in the order above)
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OMNIROUTE_API_KEY=
# Required if omniroute is in the provider order (self-hosted / gateway base URL)
OMNIROUTE_BASE_URL=

# --- Langfuse tracing (optional) ---
# https://cloud.langfuse.com (or self-hosted instance)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Pipeline ---
# How long a pending approval stays valid before auto-cancel (seconds)
APPROVAL_TTL_SECONDS=180
# How long a dispatched command may go unanswered before the orchestrator
# reports "Agent 2 did not respond" (seconds)
DISPATCH_TIMEOUT_SECONDS=60
# When true, low-risk commands skip the approval UI and auto-proceed
AUTO_PROCEED_LOW_RISK=false

# --- Audit log ---
LOG_PATH=./logs/audit.log

# --- Agent 2 (laptop executor) ---
# Local allow-list; relative paths are resolved from the working directory
AGENT2_ALLOWLIST_PATH=./config/allowlist.json
AGENT2_SHELL=/bin/bash